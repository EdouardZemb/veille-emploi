# ---------------------------------------------------------------------------
# Copie ce fichier en `config/.env` sur le serveur et remplis-le.
# `config/.env` n'est jamais versionne et doit rester en droits 600.
# ---------------------------------------------------------------------------

# --- France Travail (API officielle) ---------------------------------------
# Cree une application sur https://francetravail.io, abonne-la a
# "API Offres d'emploi v2", puis recopie les deux valeurs ici.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Alertes mail (IMAP) ----------------------------------------------------
# Gmail : active la validation en deux etapes, puis cree un MOT DE PASSE
# D'APPLICATION (16 caracteres). Ce n'est PAS ton mot de passe Gmail.
# VEILLE_IMAP_DOSSIER doit etre le libelle que ton filtre Gmail applique aux
# alertes : c'est le seul dossier que le collecteur lit.
VEILLE_IMAP_HOTE=imap.gmail.com
VEILLE_IMAP_PORT=993
VEILLE_IMAP_UTILISATEUR=camille@exemple.invalid
VEILLE_IMAP_MOTDEPASSE=
VEILLE_IMAP_DOSSIER=veille-emploi

# --- Kit de candidature -----------------------------------------------------
# Pointe vers le dossier contenant le CV maitre, les lettres types et l'annexe
# technique produits par l'autre session. Tant que c'est vide, la console prend
# les gabarits de la configuration (le dossier gabarits/ que désigne
# VEILLE_CONFIG), et dit le kit provisoire à chaque génération tant qu'elle n'y
# trouve aucune vraie pièce (un CV ou une lettre en PDF, DOCX ou ODT).
# VEILLE_KIT=/chemin/vers/le/kit

# --- Notifications ----------------------------------------------------------
# Le push web est le canal principal (sur la plupart des telephones, il est
# pleinement fiable). Le mail ne sert QUE si aucun push n'a pu partir :
# appareil hors ligne, permissions de notification revoquees, telephone laisse
# de cote.
VEILLE_MAIL_DESTINATAIRE=camille@exemple.invalid

# NE PAS repointer vers un relais local (127.0.0.1:25) sans avoir verifie
# qu'il achemine vers l'exterieur : un relais qui accepte tout et n'achemine
# rien ferait echouer le repli en silence, exactement quand il doit servir.
# On sort par Gmail, avec le MEME mot de passe d'application que l'IMAP
# ci-dessus - rien de plus a renseigner.
VEILLE_SMTP_HOTE=smtp.gmail.com
VEILLE_SMTP_PORT=587
# Laisse ces deux lignes vides : les identifiants IMAP sont repris tels quels.
VEILLE_SMTP_UTILISATEUR=
VEILLE_SMTP_MOTDEPASSE=

# Adresse de la console : OBLIGATOIRE, et EXACTEMENT celle de la barre du
# navigateur (schema, hote, port). Les passkeys se lient a son nom d'hote, et
# toute ecriture dont l'en-tete Origin n'est pas cette adresse est refusee :
# fausse, la console passe en lecture seule ; absente, la connexion par passkey
# est indisponible. Elle est aussi rappelee dans les mails de repli.
VEILLE_URL=https://console.exemple.invalid

# --- Divers -----------------------------------------------------------------
# Mettre a 0 UNIQUEMENT pour un test en local sur http://127.0.0.1 :
# le cookie de session cesse alors d'exiger HTTPS.
VEILLE_HTTPS=1

# --- Affinement de lettre (facultatif) --------------------------------------
# L'affinement par modele est un BOUTON, jamais une etape : la console produit
# toujours une lettre complete sans lui. Sans jeton, le bouton se desactive
# proprement et le reste fonctionne.
#
# ATTENTION : se reconnecter dans une session interactive NE SUFFIT PAS.
# ~/.claude/.credentials.json peut exister et ne porter que des jetons VIDES :
# une session interactive ne le reecrit pas, meme apres plusieurs reconnexions.
#
# Le remede : `claude setup-token` sur le serveur, puis coller ici le jeton
# rendu. Le service systemd charge deja ce fichier via EnvironmentFile.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Configuration de l'instance ---------------------------------------------
# Le dossier qui porte criteres.yaml, sources.yaml et gabarits/ (voir exemple/).
# Sans cette variable, le code tourne sur la configuration par defaut.
# VEILLE_CONFIG=/chemin/vers/la/configuration

# La racine de l'arborescence Node du SDK de l'affinement (facultatif).
# VEILLE_SDK_AGENT=/chemin/vers/le/sdk
